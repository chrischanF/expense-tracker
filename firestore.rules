rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match documents nested under a specific user's subcollection
    match /users/{userId}/expenses/{expenseId} {
      // Allow reading if the user is authenticated and owns the document/path
      allow read: if request.auth != null && userId == request.auth.uid;

      // Allow creating if the user is authenticated, owns the path, and attaches their own UID
      allow create: if request.auth != null && userId == request.auth.uid && request.resource.data.userId == request.auth.uid;

      // Allow updating or deleting if the user owns the path
      allow update, delete: if request.auth != null && userId == request.auth.uid;
    }
  }
}